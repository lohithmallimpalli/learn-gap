# ==============================================================================
# LearnGap — Environment Configuration Template
# Copy this file to .env and supply your personal keys (NEVER commit .env to Git)
# ==============================================================================

# Gemini AI API Key (from https://aistudio.google.com/app/apikey)
# Optional: If omitted or quota exhausted, LearnGap seamlessly uses its curated offline knowledge base.
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key for session signing, cookie encryption & CSRF security
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production

# Application Environment ('development' or 'production')
FLASK_ENV=development

# Web Server Port (Default 5001 avoids macOS AirPlay Receiver port 5000 conflict)
PORT=5001

# Production Database (Optional)
# In local development, SQLite (learngap.db) is used automatically.
# For production deployments on platforms with ephemeral filesystems (e.g., Render, Heroku),
# set a persistent PostgreSQL connection URI:
# DATABASE_URL=postgresql://user:password@host:5432/learngap_db
